<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>

        <!-- Package metadata -->
        <PackageId>WayForPaySDK</PackageId>
        <Version>1.2.1</Version>
        <Authors>Oleksii Kruhlyk</Authors>
        <Company>KRUHLYK PRO</Company>
        <Product>WayForPay SDK</Product>
        <Description>A modern .NET SDK for WayForPay payment gateway integration. Supports all major operations including Purchase, Charge, Refund, Settlement, and Status checks. Compatible with .NET 8.0, 9.0, and 10.0.</Description>
        <Copyright>Copyright © 2026 Oleksii Kruhlyk</Copyright>
        <PackageTags>wayforpay;payment;payment-gateway;sdk;ukraine;dotnet;csharp;ecommerce;online-payments;fintech</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/AratKruglik/WayForPaySDK</PackageProjectUrl>
        <RepositoryUrl>https://github.com/AratKruglik/WayForPaySDK</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageReleaseNotes>Security improvements and validation enhancements:
• XSS prevention in PaymentFormBuilder (HTML encoding for all user-controlled values)
• Signature exception properties now internal (prevents information disclosure)
• Exception messages sanitized (no raw response data in errors)
• Proper URL construction for Regular API endpoints
• Added domain validation methods (Card, Client, Product) with Luhn algorithm for card numbers
• Added options validation at startup (IValidateOptions pattern)
• Added certificate pinning support via ServerCertificateCustomValidationCallback
• Improved webhook error handling with optional ILogger support
• InvariantCulture for ReasonCode formatting (consistent signatures across cultures)</PackageReleaseNotes>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

        <!-- Build settings -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>

        <!-- Symbol package settings for debugging -->
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="9.0.0" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="9.0.0" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.0" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.0" />
        <PackageReference Include="Microsoft.Extensions.Options" Version="9.0.0" />
        <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="9.0.0" />
    </ItemGroup>

    <!-- ASP.NET Core references for webhook extensions (NET8.0+) -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net8.0' or '$(TargetFramework)' == 'net9.0' or '$(TargetFramework)' == 'net10.0'">
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <!-- Exclude test files from compilation -->
    <ItemGroup>
        <Compile Remove="tests/**/*.cs" />
    </ItemGroup>

    <!-- Include README and LICENSE in package -->
    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/" />
        <None Include="LICENSE" Pack="true" PackagePath="/" />
    </ItemGroup>

</Project>
